{
  "name": "pulso",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1 --port 5173",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1",
    "db:migrate": "wrangler d1 migrations apply pulso-demo --local",
    "db:seed": "node scripts/seed-demo.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write app lib db scripts/*.mjs vite.config.ts",
    "format:check": "prettier --check app lib db scripts/*.mjs vite.config.ts",
    "test": "node scripts/check-life.mjs && node scripts/check-gym.mjs && node scripts/check-day-clock.mjs && node scripts/check-recurrence.mjs && node scripts/check-focus.mjs",
    "test:api": "node scripts/check-records.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "0.31.10",
    "prettier": "3.6.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "description": "Personal dashboard for finances, workouts, tasks and weekly goals."
}
